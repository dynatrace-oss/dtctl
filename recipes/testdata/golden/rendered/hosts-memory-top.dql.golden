# hosts-memory-top v1 — window: default 1h
timeseries { used = avg(dt.host.memory.usage),
             avail = min(dt.host.memory.avail.bytes),
             swap_used = avg(dt.host.memory.swap.used),
             swap_total = avg(dt.host.memory.swap.total) },
  by: {dt.smartscape.host, host.name}
| fieldsAdd avg_used_pct = round(arrayAvg(used), decimals: 1),
    peak_used_pct = round(arrayMax(used), decimals: 1),
    min_avail_gib = round(arrayMin(avail) / 1073741824, decimals: 2),
    swap_used_pct = if(arrayAvg(swap_total) > 0,
      round(100 * arrayAvg(swap_used) / arrayAvg(swap_total), decimals: 1))
| filter avg_used_pct >= 0
| fields host.name, dt.smartscape.host, avg_used_pct, peak_used_pct, min_avail_gib, swap_used_pct
| sort avg_used_pct desc
| limit 20
