# traces-slow-endpoints v3 — window: default 1h, max 1d, written into the query
fetch spans, from: toTimestamp("2026-01-15T11:00:00Z"), to: toTimestamp("2026-01-15T12:00:00Z")
| filter request.is_root_span == true
| fields dt.service.name, endpoint.name, duration, trace.id,
    multiplicity = coalesce(aggregation.count, 1)
        / ((power(2, 56) - coalesce(sampling.threshold, 0)) * power(2, -56))
| fieldsAdd base = false
| append [fetch spans, from: toTimestamp("2026-01-14T11:00:00Z"), to: toTimestamp("2026-01-14T12:00:00Z")
| filter request.is_root_span == true
| fields dt.service.name, endpoint.name, duration, trace.id,
    multiplicity = coalesce(aggregation.count, 1)
        / ((power(2, 56) - coalesce(sampling.threshold, 0)) * power(2, -56))
    | fieldsAdd base = true]
| summarize { requests = toLong(round(sum(if(not(base), multiplicity, else: 0)))),
              p50 = percentile(if(not(base), duration), 50),
              p99 = percentile(if(not(base), duration), 99),
              max = max(if(not(base), duration)),
              slowest = takeMax(if(not(base), record(duration, trace.id))),
              base_requests = toLong(round(sum(if(base, multiplicity, else: 0)))),
              base_p99 = percentile(if(base, duration), 99) },
    by: {dt.service.name, endpoint.name}
| filter requests >= 10
| fields dt.service.name, endpoint.name, requests,
    p50_ms = round(p50 / 1ms, decimals: 1), p99_ms = round(p99 / 1ms, decimals: 1),
    max_ms = round(max / 1ms, decimals: 1),
    base_p99_ms = round(base_p99 / 1ms, decimals: 1), base_requests,
    p99_vs_base = round(toDouble(p99) / toDouble(base_p99), decimals: 2),
    slowest_trace_id = slowest[trace.id]
| sort p99_ms desc
| limit 15
