# traces-slow-endpoints v2 — window: default 1h, max 1d
fetch spans
| filter request.is_root_span == true
| fieldsAdd multiplicity = coalesce(aggregation.count, 1)
        / ((power(2, 56) - coalesce(sampling.threshold, 0)) * power(2, -56))
| summarize { requests = toLong(round(sum(multiplicity))),
              p50 = percentile(duration, 50), p99 = percentile(duration, 99),
              max = max(duration), slowest = takeMax(record(duration, trace.id)) },
    by: {dt.service.name, endpoint.name}
| filter requests >= 10
| fields dt.service.name, endpoint.name, requests,
    p50_ms = round(p50 / 1ms, decimals: 1), p99_ms = round(p99 / 1ms, decimals: 1),
    max_ms = round(max / 1ms, decimals: 1), slowest_trace_id = slowest[trace.id]
| sort p99_ms desc
| limit 15
