# hosts-disk-saturation v1 — window: default 1h
timeseries { used = avg(dt.host.disk.used.percent), avail = avg(dt.host.disk.avail) },
  by: {dt.smartscape.host, host.name, dt.smartscape.disk}
| fieldsAdd avg_used_pct = round(arrayAvg(used), decimals: 1)
| filter avg_used_pct >= 80
| fieldsAdd disk = getNodeName(dt.smartscape.disk),
    peak_used_pct = round(arrayMax(used), decimals: 1),
    avail_gib = round(arrayLast(avail) / 1073741824, decimals: 1)
| filterOut contains(disk, "/kubelet/pods/")
| fields host.name, disk, avg_used_pct, peak_used_pct, avail_gib, dt.smartscape.host, dt.smartscape.disk
| sort avg_used_pct desc
| limit 50
