# services-failure-logs v1 — window: default 30m, max 2h
fetch logs
| filter trace_id in [fetch spans
    | filter dt.service.name == "<service>"
    | filter request.is_failed == true or span.status_code == "error"
    | fields tid = toString(trace.id)]
| summarize { lines = count(), traces = countDistinctExact(trace_id),
      first_seen = min(timestamp), last_seen = max(timestamp),
      example = takeMax(record(timestamp, content = substring(content, from: 0, to: 300))) },
    by: { source = coalesce(k8s.workload.name, dt.service.name, service.name,
          dt.process_group.detected_name, faas.name, aws.log_group, log.source, host.name,
          dt.openpipeline.source), status }
| fields source, status, lines, traces, first_seen, last_seen, example = example[content]
| sort lines desc
| limit 25
