# genai-token-usage v3 — window: default 2h, max 7d
fetch spans
| filter isNotNull(gen_ai.usage.input_tokens) or isNotNull(gen_ai.usage.output_tokens)
| fieldsAdd model = coalesce(gen_ai.request.model, gen_ai.response.model)
| dedup {trace.id, gen_ai.usage.input_tokens, gen_ai.usage.output_tokens}, sort: {start_time asc}
| summarize { calls = count(),
    input_tokens = toLong(sum(gen_ai.usage.input_tokens)),
    output_tokens = toLong(sum(gen_ai.usage.output_tokens)),
    cache_read_tokens = toLong(sum(gen_ai.usage.cache_read.input_tokens)) },
  by: {provider = coalesce(gen_ai.provider.name, gen_ai.system), model}
| fieldsAdd total_tokens = coalesce(input_tokens, 0) + coalesce(output_tokens, 0)
| sort total_tokens desc
| limit 50
