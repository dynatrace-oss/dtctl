objectid: gcpmon-a1b2c3d4
scope: ""
value:
  enabled: true
  description: Production GCP monitoring
  version: "2.0"
  googlecloud:
    credentials:
      - description: Main SA credential
        enabled: true
        connectionid: gcp-conn-x1y2z3
        serviceaccount: sa-monitor@project-id.iam.gserviceaccount.com
    locationfiltering:
      - us-east1
      - eu-west1
    projectfiltering:
      - my-project-123
    folderfiltering: []
    tagfiltering: []
    labelfiltering: []
    tagenrichment: []
    labelenrichment: []
    observabilityscopesenabled: false
    smartscapeconfiguration:
      enabled: false
    resources:
      - resourcetype: pubsub_topic
        autodiscoveryenabled: false
        autodiscoveryexcludemetrictype: []
        metrics:
          - name: pubsub.googleapis.com/topic/send_request_count
            metriclabels:
              - response_class
            type: CUSTOM
      - resourcetype: gce_instance
        autodiscoveryenabled: true
        autodiscoveryexcludemetrictype:
          - compute.googleapis.com/instance/disk/*
        metrics: []
  featuresets:
    - default
description: Production GCP monitoring
enabled: true
version: "2.0"
